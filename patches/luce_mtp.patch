@@ -0,0 +1,87 @@
+#!/usr/bin/env python3
+"""Count tensor quant types in a GGUF by parsing only the header."""
+import struct, sys, collections
+
+NAMES = {
+    0:"F32",1:"F16",2:"Q4_0",3:"Q4_1",6:"Q5_0",7:"Q5_1",8:"Q8_0",9:"Q8_1",
+    10:"Q2_K",11:"Q3_K",12:"Q4_K",13:"Q5_K",14:"Q6_K",15:"Q8_K",
+    16:"IQ2_XXS",17:"IQ2_XS",18:"IQ3_XXS",19:"IQ1_S",20:"IQ4_NL",21:"IQ3_S",
+    22:"IQ2_S",23:"IQ4_XS",24:"I8",25:"I16",26:"I32",27:"I64",28:"F64",
+    29:"IQ1_M",30:"BF16",34:"TQ1_0",35:"TQ2_0",
+    39:"TURBO2_0",40:"TURBO3_0",41:"TURBO4_0",44:"TQ3_0",
+    45:"TQ3_1S",46:"TQ4_1S",
+}
+# (block_elems, bytes_per_block) for bpw math
+BLK = {
+    0:(1,4),1:(1,2),30:(1,2),8:(32,34),12:(256,144),13:(256,176),14:(256,210),
+    10:(256,84),11:(256,110),23:(256,136),20:(32,18),
+    45:(32,16),46:(32,20),
+}
+
+f = open(sys.argv[1], "rb")
+def r(n): return f.read(n)
+def u32(): return struct.unpack("<I", r(4))[0]
+def u64(): return struct.unpack("<Q", r(8))[0]
+def i32(): return struct.unpack("<i", r(4))[0]
+
+assert r(4) == b"GGUF", "not a GGUF"
+ver = u32(); n_tensors = u64(); n_kv = u64()
+print(f"gguf v{ver}  tensors={n_tensors}  kv={n_kv}")
+
+def rd_str():
+    return r(u64()).decode("utf-8", "replace")
+
+def rd_val(t):
+    if t == 0:  return struct.unpack("<B", r(1))[0]
+    if t == 1:  return struct.unpack("<b", r(1))[0]
+    if t == 2:  return struct.unpack("<H", r(2))[0]
+    if t == 3:  return struct.unpack("<h", r(2))[0]
+    if t == 4:  return u32()
+    if t == 5:  return i32()
+    if t == 6:  return struct.unpack("<f", r(4))[0]
+    if t == 7:  return struct.unpack("<?", r(1))[0]
+    if t == 8:  return rd_str()
