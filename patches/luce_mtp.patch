+    if t == 12: return struct.unpack("<d", r(8))[0]
+    raise ValueError(f"bad kv type {t}")
+
+meta = {}
+for _ in range(n_kv):
+    k = rd_str(); t = u32(); meta[k] = rd_val(t)
+
+for k in sorted(meta):
+    if any(s in k for s in ("file_type","architecture","block_count","name",
+                            "attention.head_count","ssm.","expert","embedding_length")):
+        v = meta[k]
+        if isinstance(v, list): v = f"[{len(v)} items]"
+        print(f"  {k} = {v}")
+
+cnt = collections.Counter()
+params = collections.Counter()
+bytes_by = collections.Counter()
+for _ in range(n_tensors):
+    name = rd_str()
+    nd = u32()
+    dims = [u64() for _ in range(nd)]
+    tt = u32(); off = u64()
+    ne = 1
+    for d in dims: ne *= d
+    cnt[tt] += 1
+    params[tt] += ne
+    if tt in BLK:
+        be, bb = BLK[tt]
+        bytes_by[tt] += ne // be * bb
