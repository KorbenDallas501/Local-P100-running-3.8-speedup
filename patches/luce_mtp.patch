+// LUCE_SKIP_LAYERS="7,9,11" -- whole-block identity passthrough, default off (E7).
+// Also readable from the file named by LUCE_SKIP_FILE, re-read when that file's mtime changes.
+// The file path exists for a THERMAL reason: on the P100 a model reload costs ~5 C of an ~8 C
+// per-arm budget, so reloading the server per A/B arm spends most of the thermal budget on
+// nothing and soaks the card after a handful of arms. A resident server able to switch skip
+// sets between pulses roughly triples the arms available per boot. Steady-state cost is one
+// stat() per graph build; the set is only re-parsed when mtime moves.
+static bool & luce_skip_changed() { static bool c = true; return c; }
+
+static const std::set<int> & luce_skip_layers() {
+    static std::set<int> s;
+    static bool   env_done   = false;
+    static time_t last_mtime = 0;
+    const char * f = getenv("LUCE_SKIP_FILE");
+    if (f) {
+        struct stat st;
+        if (stat(f, &st) == 0 && st.st_mtime != last_mtime) {
+            last_mtime = st.st_mtime;
+            s.clear();
+            std::ifstream in(f);
+            std::string body, tok;
+            std::getline(in, body);
+            std::stringstream ss(body);
+            while (std::getline(ss, tok, ',')) {
+                if (!tok.empty() && tok != "none") s.insert(std::stoi(tok));
+            }
+            luce_skip_changed() = true;
+            fprintf(stderr, "LUCE_SKIP_FILE reloaded: %zu blocks\n", s.size());
+        }
+        return s;
+    }
+    if (!env_done) {
+        env_done = true;
+        const char * e = getenv("LUCE_SKIP_LAYERS");
+        if (e) {
+            std::stringstream ss(e);
+            std::string tok;
+            while (std::getline(ss, tok, ',')) {
+                if (!tok.empty()) s.insert(std::stoi(tok));
+            }
+        }
+    }
+    return s;
+}
