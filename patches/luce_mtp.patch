+    const std::set<int> & skip_set = luce_skip_layers();
+    if (!skip_set.empty() && luce_skip_changed()) {
+        luce_skip_changed() = false;
+        fprintf(stderr, "LUCE_SKIP_LAYERS active: n_layer=%d n_layer_all=%d n_layer_nextn=%d\n",
+                n_layer, (int) hparams.n_layer_all, (int) hparams.n_layer_nextn);
+        GGML_ASSERT(!skip_set.count(0)           && "LUCE_SKIP_LAYERS: layer 0 is not skippable");
+        GGML_ASSERT(!skip_set.count(n_layer - 1) && "LUCE_SKIP_LAYERS: last layer carries inp_out_ids");
+        for (int il : skip_set) {
+            GGML_ASSERT(il > 0 && il < n_layer   && "LUCE_SKIP_LAYERS: index out of range");
+            fprintf(stderr, "LUCE_SKIP_LAYERS:   skip il=%d is_recr=%d\n", il, (int) hparams.is_recr(il));
