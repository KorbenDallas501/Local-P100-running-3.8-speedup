+print(f"\n{'type':<10}{'tensors':>9}{'params':>16}{'bytes':>16}{'bpw':>8}")
+tot_p = tot_b = 0
+for tt, c in cnt.most_common():
+    p = params[tt]; b = bytes_by.get(tt, 0)
+    bpw = f"{b*8/p:.2f}" if (b and p) else "?"
+    print(f"{NAMES.get(tt,'t'+str(tt)):<10}{c:>9}{p:>16,}{b:>16,}{bpw:>8}")
+    tot_p += p; tot_b += b
+print(f"{'TOTAL':<10}{sum(cnt.values()):>9}{tot_p:>16,}{tot_b:>16,}"
+      f"{tot_b*8/tot_p:>8.2f}" if tot_p else "")
diff --git a/scripts/p100_fp16_probe.cu b/scripts/p100_fp16_probe.cu
new file mode 100644
index 000000000..782bec55d
--- /dev/null
+++ b/scripts/p100_fp16_probe.cu
@@ -0,0 +1,136 @@
+// Item #10 probe: on GP100 (sm_60) is a half2 dequant-dot mat-vec faster than the
+// int8/XMAD path llama.cpp's mmvq is forced onto?
+//
+// sm_60 has NO native __dp4a and NO native 32-bit IMAD: llama.cpp's mmvq compiles to
+// 81,883 XMAD in mmvq.cu.o. GP100 is, however, the one Pascal with half2 at 2x fp32.
+// This compares, on the same 4096x14336 shape llama.cpp's perf suite uses:
+//   A) int8 dot with the exact scalar dp4a fallback sm_60 gets   (baseline)
+//   B) half2 dequant-dot                                          (the proposal)
+// Anchor: llama.cpp's real q4_1 mmvq measures 118.73 us/run on this shape, so if (A)
+// lands near that, the comparison is credible rather than a strawman.
+#include <cstdio>
+#include <ctime>
+#include <cstdlib>
+#include <cuda_fp16.h>
+
+#define QK 32                       // q4_1 block
+#define M 4096
+#define K 14336
+#define WARP 32
+
+struct blk_q4_1 { half d; half m; unsigned char qs[QK/2]; };
+
+__device__ __forceinline__ int dp4a_emul(int a, int b, int c) {
+    const signed char * a8 = (const signed char *)&a;
+    const signed char * b8 = (const signed char *)&b;
+    return c + a8[0]*b8[0] + a8[1]*b8[1] + a8[2]*b8[2] + a8[3]*b8[3];
+}
+
+// A) int8 path: activations pre-quantized to int8 per 32-block, weights unpacked to int8.
+__global__ void mv_int8(const blk_q4_1 * __restrict__ w, const signed char * __restrict__ xq,
+                        const float * __restrict__ xs, float * __restrict__ out) {
+    const int row = blockIdx.x;
+    const int lane = threadIdx.x;
+    const int nb = K / QK;
+    float acc = 0.f;
+    for (int b = lane; b < nb; b += WARP) {
+        const blk_q4_1 & bl = w[row*nb + b];
+        int isum = 0;
+        #pragma unroll
+        for (int i = 0; i < QK/8; i++) {
+            int wpack = 0, xpack = 0;
+            #pragma unroll
+            for (int j = 0; j < 4; j++) {
+                const int idx = i*4 + j;
+                const unsigned char byte = bl.qs[idx];
+                ((signed char*)&wpack)[j] = (signed char)(byte & 0x0F);
+                ((signed char*)&xpack)[j] = xq[b*QK + idx];
+            }
+            isum = dp4a_emul(wpack, xpack, isum);
+            #pragma unroll
+            for (int j = 0; j < 4; j++) {
+                const int idx = i*4 + j;
+                ((signed char*)&wpack)[j] = (signed char)(bl.qs[idx] >> 4);
+                ((signed char*)&xpack)[j] = xq[b*QK + 16 + idx];
+            }
+            isum = dp4a_emul(wpack, xpack, isum);
+        }
+        acc += __half2float(bl.d) * xs[b] * (float)isum;
+    }
+    #pragma unroll
+    for (int off = WARP/2; off > 0; off >>= 1) acc += __shfl_xor_sync(0xffffffff, acc, off, WARP);
+    if (lane == 0) out[row] = acc;
+}
+
+// B) half2 path: unpack the nibbles straight to half2 and FMA against half2 activations.
+__global__ void mv_half2(const blk_q4_1 * __restrict__ w, const half2 * __restrict__ xh,
+                         float * __restrict__ out) {
+    const int row = blockIdx.x;
+    const int lane = threadIdx.x;
+    const int nb = K / QK;
+    float acc = 0.f;
+    for (int b = lane; b < nb; b += WARP) {
+        const blk_q4_1 & bl = w[row*nb + b];
+        const half2 d2 = __half2half2(bl.d);
+        const half2 m2 = __half2half2(bl.m);
+        half2 s = __float2half2_rn(0.f);
+        #pragma unroll
+        for (int i = 0; i < QK/4; i++) {
+            const unsigned char b0 = bl.qs[i*2 + 0];
+            const unsigned char b1 = bl.qs[i*2 + 1];
+            const half2 lo = __halves2half2(__int2half_rn(b0 & 0x0F), __int2half_rn(b1 & 0x0F));
+            const half2 hi = __halves2half2(__int2half_rn(b0 >> 4),   __int2half_rn(b1 >> 4));
+            const half2 wlo = __hfma2(lo, d2, m2);
+            const half2 whi = __hfma2(hi, d2, m2);
+            s = __hfma2(wlo, xh[(b*QK)/2 + i],        s);
+            s = __hfma2(whi, xh[(b*QK)/2 + i + QK/4], s);
+        }
+        acc += __half2float(__low2half(s)) + __half2float(__high2half(s));
+    }
+    #pragma unroll
+    for (int off = WARP/2; off > 0; off >>= 1) acc += __shfl_xor_sync(0xffffffff, acc, off, WARP);
+    if (lane == 0) out[row] = acc;
+}
+
+// The P100 idles at 405 MHz and takes ~300 ms to ramp to ~1113-1189 MHz. A single warm
+// call leaves the whole timed region on the idle clock, which is what invalidated the
+// first run of this probe. Spin for a fixed wall-clock warmup instead.
+template <typename F> static float timeit(F f, int iters, double warm_s = 1.0) {
+    cudaEvent_t a, b; cudaEventCreate(&a); cudaEventCreate(&b);
+    f(); cudaDeviceSynchronize();
+    const clock_t t0 = clock();
+    while ((double)(clock() - t0) / CLOCKS_PER_SEC < warm_s) {
+        for (int i = 0; i < 64; i++) f();
+        cudaDeviceSynchronize();
+    }
+    cudaEventRecord(a);
+    for (int i = 0; i < iters; i++) f();
+    cudaEventRecord(b); cudaEventSynchronize(b);
+    float ms = 0.f; cudaEventElapsedTime(&ms, a, b);
+    return ms * 1000.f / iters;                   // us/run
+}
+
+int main(int argc, char ** argv) {
+    // default sized so the timed region alone runs >= ~2 s at this shape
+    const int iters = argc > 1 ? atoi(argv[1]) : 20000;
+    const int nb = K / QK;
+    blk_q4_1 * w; signed char * xq; float * xs; half2 * xh; float * out;
+    cudaMalloc(&w,  (size_t)M*nb*sizeof(blk_q4_1));
+    cudaMalloc(&xq, K); cudaMalloc(&xs, nb*sizeof(float));
+    cudaMalloc(&xh, (K/2)*sizeof(half2)); cudaMalloc(&out, M*sizeof(float));
+    cudaMemset(w, 0x42, (size_t)M*nb*sizeof(blk_q4_1));
+    cudaMemset(xq, 3, K); cudaMemset(xs, 0, nb*sizeof(float));
+    cudaMemset(xh, 0x3c, (K/2)*sizeof(half2));
+
+    const float t_i8 = timeit([&]{ mv_int8 <<<M, WARP>>>(w, xq, xs, out); }, iters);
+    const float t_h2 = timeit([&]{ mv_half2<<<M, WARP>>>(w, xh, out);      }, iters);
+    cudaError_t e = cudaGetLastError();
+    if (e != cudaSuccess) { printf("CUDA error: %s\n", cudaGetErrorString(e)); return 1; }
+
+    const double wts = (double)M*K;
+    printf("shape m=%d k=%d  iters=%d\n", M, K, iters);
+    printf("A int8/XMAD  : %8.2f us/run   %5.2f ps/weight\n", t_i8, t_i8*1e6/wts);
+    printf("B half2/HFMA2: %8.2f us/run   %5.2f ps/weight\n", t_h2, t_h2*1e6/wts);
+    printf("speedup B/A  : %5.2fx   (llama.cpp mmvq q4_1 anchor = 118.73 us / 2.02 ps)\n", t_i8/t_h2);
+    return 0;
+}
