diff --git a/scripts/bench_dp4a_penalty.sh b/scripts/bench_dp4a_penalty.sh
new file mode 100644
index 000000000..7d54ecbff
--- /dev/null
+++ b/scripts/bench_dp4a_penalty.sh
@@ -0,0 +1,22 @@
+#!/usr/bin/env bash
+P=${PROBE_DIR:-./dp4a_probe}
+R=${LUCE_DIR:-.}
+B1=$R/build-dp4a/bin/llama-bench
+B0=$R/build-nodp4a/bin/llama-bench
+
+ts() {  # $1=binary $2=model
+  "$1" -m "$2" -ngl 99 -p 0 -n 128 -r 3 -o csv 2>/dev/null \
+    | tail -1 | awk -F, '{gsub(/"/,"",$(NF-1)); print $(NF-1)}'
+}
+
+printf "%-9s %11s %11s %10s\n" quant "dp4a" "emulated" "slowdown"
+for T in Q4_0 Q4_K_M IQ4_XS IQ3_S IQ2_S; do
+  M=$P/q-$T.gguf
+  [ -f "$M" ] || continue
+  A=$(ts "$B1" "$M"); B=$(ts "$B0" "$M")
+  if [ -n "$A" ] && [ -n "$B" ]; then
+    printf "%-9s %11.2f %11.2f %9.2fx\n" "$T" "$A" "$B" "$(echo "$A/$B" | bc -l)"
+  else
+    printf "%-9s %11s %11s\n" "$T" "${A:-FAIL}" "${B:-FAIL}"
+  fi
+done
