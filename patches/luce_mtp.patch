diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 15c42ebb1..7b43573e5 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -629,6 +629,142 @@ static std::mutex ggml_cuda_lock;
 static std::condition_variable ggml_cuda_lock_cv;
 static std::atomic<int> ggml_cuda_lock_counter;
 
+#ifdef USE_CUDA_GRAPH
+// LUCE: graph-capture instrumentation. The pre-Ampere gate is a heuristic, and the previous
+// sm_60 A/B (LUCE_CUDA_GRAPHS=1, three pairs, all -1.1..-1.8%) could not distinguish
+// "captured and still slower" from "never captured, paying only attempt overhead", because the
+// bail-out messages are GGML_LOG_DEBUG and llama-server's log callback filters them.
+// These counters are INFO-level so they survive that filter. LUCE_GRAPH_STATS=1 to enable.
+static std::atomic<uint64_t> luce_g_capture{0}, luce_g_launch{0}, luce_g_direct{0},
+                             luce_g_instantiate{0}, luce_g_update{0};
+static bool luce_graph_stats() {
+    static const bool on = [] {
+        const char * e = getenv("LUCE_GRAPH_STATS");
+        return e && e[0] == '1';
+    }();
+    return on;
+}
+static void luce_graph_report(const char * where) {
+    if (!luce_graph_stats()) { return; }
+    const uint64_t l = luce_g_launch.load() + luce_g_direct.load();
+    // report on the first few, then every 256 dispatches
+    if (l > 4 && (l & 255) != 0) { return; }
+    GGML_LOG_INFO("LUCE_GRAPH[%s]: capture=%llu instantiate=%llu update=%llu launch=%llu direct_eval=%llu\n",
+        where,
+        (unsigned long long) luce_g_capture.load(),
+        (unsigned long long) luce_g_instantiate.load(),
+        (unsigned long long) luce_g_update.load(),
+        (unsigned long long) l,
+        (unsigned long long) luce_g_direct.load());
+}
+
+#endif // USE_CUDA_GRAPH
+
+// LUCE: per-op GPU time attribution. LUCE_OP_PROFILE=1.
+// Motivation: ~18 ms of the marginal second-column decode cost is unattributed, and no
+// profiler (nsys/ncu) is installed on the Z640. Pascal disables CUDA graphs by default, so
+// the direct-eval loop is the live path and every node can be bracketed with events.
+// Events are resolved once per graph rather than per node, so the launch stream is not
+// serialised at each op.
+static bool luce_op_profile() {
+    static const bool on = [] {
+        const char * e = getenv("LUCE_OP_PROFILE");
+        return e && e[0] == '1';
+    }();
+    return on;
+}
+
+struct luce_prof_slot {
+    cudaEvent_t a;
+    cudaEvent_t b;
+    std::string key;
+};
+static std::vector<luce_prof_slot>                          luce_prof_slots;
+static size_t                                               luce_prof_used   = 0;
+static std::map<std::string, std::pair<double, uint64_t>>   luce_prof_acc;
+static uint64_t                                             luce_prof_graphs = 0;
+
+static std::string luce_prof_key(const ggml_tensor * node) {
+    char buf[160];
+    if ((node->op == GGML_OP_MUL_MAT || node->op == GGML_OP_MUL_MAT_ID) && node->src[0] && node->src[1]) {
+        // src0 row count is included so output.weight (248320 rows) separates from the
+        // layer tensors that share its quant type -- bucketing by type alone could not
+        // tell them apart in the n=4 target graph.
+        snprintf(buf, sizeof(buf), "%s[%s,r=%d,n=%d]", ggml_op_name(node->op),
+                 ggml_type_name(node->src[0]->type), (int) node->src[0]->ne[1],
+                 (int) node->src[1]->ne[1]);
+    } else if (node->op == GGML_OP_FLASH_ATTN_EXT && node->src[1]) {
+        snprintf(buf, sizeof(buf), "FLASH_ATTN_EXT[kv=%d]", (int) node->src[1]->ne[1]);
+    } else {
+        snprintf(buf, sizeof(buf), "%s", ggml_op_name(node->op));
+    }
+    return std::string(buf);
+}
+
+static void luce_prof_begin(const ggml_tensor * node, cudaStream_t stream) {
+    if (!luce_op_profile()) { return; }
+    if (luce_prof_used == luce_prof_slots.size()) {
+        luce_prof_slot s = {};
+        CUDA_CHECK(cudaEventCreate(&s.a));
+        CUDA_CHECK(cudaEventCreate(&s.b));
+        luce_prof_slots.push_back(s);
+    }
+    luce_prof_slots[luce_prof_used].key = luce_prof_key(node);
+    CUDA_CHECK(cudaEventRecord(luce_prof_slots[luce_prof_used].a, stream));
+}
+
+static void luce_prof_end(cudaStream_t stream) {
+    if (!luce_op_profile()) { return; }
+    CUDA_CHECK(cudaEventRecord(luce_prof_slots[luce_prof_used].b, stream));
+    luce_prof_used++;
+}
+
+static void luce_prof_flush() {
+    if (!luce_op_profile() || luce_prof_used == 0) { return; }
+    CUDA_CHECK(cudaEventSynchronize(luce_prof_slots[luce_prof_used - 1].b));
+    for (size_t i = 0; i < luce_prof_used; ++i) {
+        float ms = 0.0f;
+        CUDA_CHECK(cudaEventElapsedTime(&ms, luce_prof_slots[i].a, luce_prof_slots[i].b));
+        std::pair<double, uint64_t> & e = luce_prof_acc[luce_prof_slots[i].key];
+        e.first  += ms;
+        e.second += 1;
+    }
+    luce_prof_used = 0;
+    luce_prof_graphs++;
+
+    static const uint64_t every = [] {
+        const char * e = getenv("LUCE_OP_PROFILE_EVERY");
+        const long v = e ? atol(e) : 0;
+        return (uint64_t) (v > 0 ? v : 64);
+    }();
+    if (luce_prof_graphs % every != 0) { return; }
+
