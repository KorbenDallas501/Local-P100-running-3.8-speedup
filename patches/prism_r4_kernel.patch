+template<int B,int RPW,int NW> __global__ void pq2_row_warp(const block_pq2_0*w,const block_q8_1*a,float*y,int M,int K){
+ constexpr int VW=B<=4?4:2;
+ constexpr int qi=ggml_cuda_type_traits<GGML_TYPE_PQ2_0>::qi;
+ constexpr int vdr=get_vdr_mmvq(GGML_TYPE_PQ2_0);
+ constexpr int step=vdr*VW*32/qi;
+ const int row=(blockIdx.x*NW+threadIdx.y)*RPW;
+ if(row>=M)return;
+ float tmp[B][RPW][VW]={};
+ for(int kb=threadIdx.x/(qi/vdr);kb<K/128;kb+=step){
+  #pragma unroll
+  for(int v=0;v<VW;v++){
+   const int kbx=kb+v*32/(qi/vdr);
+   if(kbx<K/128){
+    const int kby=kbx*4, kqs=vdr*(threadIdx.x%(qi/vdr));
+    #pragma unroll
+    for(int j=0;j<B;j++){
+     #pragma unroll
+     for(int r=0;r<RPW;r++){
+      tmp[j][r][v]+=vec_dot_pq2_0_q8_1(w,a+j*(K/32)+kby,(row+r)*(K/128)+kbx,kqs);
+     }
+    }
+   }
+  }
+ }
+ #pragma unroll
+ for(int j=0;j<B;j++){
+  #pragma unroll
+  for(int r=0;r<RPW;r++){
+   #pragma unroll
+   for(int v=1;v<VW;v++)tmp[j][r][0]+=tmp[j][r][v];
+   float result=warp_reduce_sum<32>(tmp[j][r][0]);
+   if(threadIdx.x==r)y[j*M+row+r]=result;
+  }
+ }
+}
